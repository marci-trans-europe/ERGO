{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ERGO",
  "version": "0.3.1",
  "identifier": "hu.transeurope.ergo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ERGO · Élő ERP Elemző",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "category": "Business",
    "shortDescription": "Élő, csak olvasható ERP-elemző",
    "longDescription": "A Trans-Europe belső, természetes nyelvű ERP-adatelemző alkalmazása.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCNTIwMjRBQ0M4QTdDODIKUldTQ2ZJck1TZ0pTMi9pT3FsMzczcERQa2U5d2ZBdlNrNlRCTXEwYXV4bEhMNXRYdExCMnJyL2gK",
      "endpoints": [
        "https://github.com/marci-trans-europe/ERGO/releases/latest/download/latest.json"
      ]
    }
  }
}
